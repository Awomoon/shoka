# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# build artifacts (released via GitHub Releases, never committed)
*.apk

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Next.js landing page (landing/ builds into docs/ via npm run build:docs)
landing/.next/
landing/out/
landing/next-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
